# EcoCircuit frontend env — copy this file to ".env" and fill in your values.
# (Restart `npm run dev` after changing env vars — Vite only reads them at start.)

# Supabase project credentials: Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# URL of the FastAPI ML backend (server/). Default local dev value:
VITE_API_URL=http://localhost:8000
