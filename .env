# EcoCircuit frontend environment (LOCAL ONLY — gitignored, never committed).
# Vite only reads these at startup, so restart `npm run dev` after editing.
#
# Paste your Supabase project values below (Dashboard -> Project Settings -> API).
# Leaving them BLANK is safe: the app boots and shows a "Supabase not configured"
# message instead of crashing. It only attempts auth once BOTH are filled in.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL of the FastAPI ML backend (server/). Default local dev value:
VITE_API_URL=http://localhost:8000
